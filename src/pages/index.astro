---
import "../style.css";
---

<html lang="ko">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>my little internet ♡</title>
</head>

<body>

    <div class="website">

        <!-- HEADER -->

        <header class="header">

            <h1>♡ my little internet ♡</h1>

            <p>
                welcome to my little corner of the internet
            </p>

        </header>


        <!-- NAVIGATION -->

        <nav class="navigation">

            <a href="/">home</a>
            <a href="/blog/">blog</a>
            <a href="#">about</a>
            <a href="#">links</a>

        </nav>


        <!-- CONTENT -->

        <main class="card-grid">


            <!-- CARD 1 -->

            <article class="card">

                <div class="card-image">
                    <img src="/images/test.jpg" alt="my photo">
                </div>

                <h2>hello!</h2>

                <p>
                    welcome to my website ♡
                </p>

                <span class="star">☆</span>

            </article>


            <!-- CARD 2 -->

            <article class="card">

                <div class="card-image placeholder">
                    ✦
                </div>

                <h2>my diary</h2>

                <p>
                    little things from my everyday life.
                </p>

                <span class="star">☆</span>

            </article>


            <!-- CARD 3 -->

            <article class="card">

                <div class="card-image placeholder">
                    ♡
                </div>

                <h2>blog</h2>

                <p>
                    thoughts, notes & random things.
                </p>

                <span class="star">☆</span>

            </article>


            <!-- CARD 4 -->

            <article class="card">

                <div class="card-image placeholder">
                    ✧
                </div>

                <h2>about me</h2>

                <p>
                    a little bit about myself.
                </p>

                <span class="star">☆</span>

            </article>


            <!-- CARD 5 -->

            <article class="card">

                <div class="card-image placeholder">
                    ♡
                </div>

                <h2>favorites</h2>

                <p>
                    things I love lately.
                </p>

                <span class="star">☆</span>

            </article>


            <!-- CARD 6 -->

            <article class="card">

                <div class="card-image placeholder">
                    ✦
                </div>

                <h2>links</h2>

                <p>
                    places I like on the internet.
                </p>

                <span class="star">☆</span>

            </article>


        </main>


        <!-- FOOTER -->

        <footer class="footer">

            <p>♡ thanks for visiting ♡</p>

        </footer>

    </div>

</body>

</html>